# ==========================================================
# Clarity Environment Configuration
# ==========================================================
# Google Gemini API Key
# If not provided, Clarity automatically falls back to its built-in
# local legal intelligence engine for zero-configuration testing & CI.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Environment
NODE_ENV=development
